// GET /api/ai/predict-tomorrow-checkouts - Predict tomorrow's departures
app.get('/api/ai/predict-tomorrow-checkouts', async (req, res) => {
    try {
        // Get historical checkout data for the last 30 days
        const history = await pool.query(`
            SELECT 
                DATE(check_out) as date,
                COUNT(*) as checkouts
            FROM reservations 
            WHERE status = 'checked-out'
            AND check_out >= CURRENT_DATE - INTERVAL '30 days'
            GROUP BY DATE(check_out)
            ORDER BY date
        `);
        
        // Get today's occupancy to influence prediction
        const currentOccupancy = await pool.query(`
            SELECT COUNT(*) as occupied
            FROM rooms WHERE status = 'occupied'
        `);
        
        // Simple AI prediction based on:
        // 1. Average checkouts from last 7 days
        // 2. Current occupancy
        // 3. Day of week factor
        
        const last7Days = history.rows.slice(-7);
        const avgCheckouts = last7Days.length > 0 
            ? last7Days.reduce((sum, day) => sum + parseInt(day.checkouts), 0) / last7Days.length 
            : 5;
        
        const dayOfWeek = new Date().getDay(); // 0 = Sunday, 6 = Saturday
        let dayFactor = 1.0;
        if (dayOfWeek === 5 || dayOfWeek === 6) dayFactor = 1.3; // Weekend higher checkouts
        if (dayOfWeek === 0) dayFactor = 0.8; // Sunday lower
        
        const currentOcc = parseInt(currentOccupancy.rows[0].occupied);
        const occupancyFactor = currentOcc / 10; // Rough estimate
        
        const prediction = Math.round(avgCheckouts * dayFactor * (occupancyFactor || 1));
        
        // Generate recommendation based on prediction
        let recommendation = '';
        let suggestedStaff = 2;
        

// Function to send email (real or demo)
async function sendEmail(to, subject, htmlContent) {
    const emailLog = {
        to,
        subject,
        timestamp: new Date().toISOString(),
        contentPreview: htmlContent.substring(0, 200) + '...'
    };
    
    // If SendGrid is configured, send real email
    if (process.env.SENDGRID_API_KEY) {
        try {
            const msg = {
                to: to,
                from: process.env.EMAIL_FROM || 'noreply@ruviaos.com',
                subject: subject,
                html: htmlContent
            };
            await sgMail.send(msg);
            console.log('📧 REAL EMAIL SENT:', emailLog);
            return { success: true, real: true };
        } catch (error) {
            console.error('❌ SendGrid error:', error.response?.body || error.message);
            console.log('📧 Falling back to demo mode for this email');
            console.log('📧 EMAIL CONTENT (would have been sent):', htmlContent.substring(0, 500));
            return { success: false, error: error.message };
        }
    } else {
        // Demo mode - just log to console
        console.log('📧 DEMO MODE - Email would be sent:', emailLog);
        console.log('📧 EMAIL CONTENT:', htmlContent.substring(0, 500));
        return { success: true, demo: true };
    }
}


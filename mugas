        }
        
        // Holiday season factor
        if (isHolidaySeason) {
            multiplier *= 1.20;
            reasons.push('Holiday season');
        }
        
        // Day of week factor
        const dayOfWeek = today.getDay();
        if (dayOfWeek === 0) { // Sunday
            multiplier *= 0.9;
            reasons.push('Sunday discount');
        }
        
        const optimalPrice = Math.round(basePrice * multiplier);
        const priceTiers = [
            { room_type: 'Standard', price: Math.round(optimalPrice * 0.8) },
            { room_type: 'Deluxe', price: Math.round(optimalPrice * 1.2) },
            { room_type: 'Suite', price: Math.round(optimalPrice * 1.8) }
        ];
        
        res.json({
            base_price: basePrice,
            optimal_price: optimalPrice,
            multiplier: multiplier.toFixed(2),
            factors: reasons,
            price_tiers: priceTiers,
            expected_revenue_impact: multiplier > 1 ? `+${Math.round((multiplier - 1) * 100)}% revenue expected` : `${Math.round((multiplier - 1) * 100)}% revenue impact`,
            recommendation: multiplier > 1.1 ? 'Increase prices - strong demand detected' :
                           multiplier < 0.95 ? 'Decrease prices - low demand detected' :
                           'Maintain current pricing'
        });
        
    } catch (err) {
        console.error('Price optimization error:', err);
        res.json({ base_price: 100, optimal_price: 100, recommendation: 'Maintain current pricing' });
    }
});

// GET /api/ai/churn-prediction - Identify guests at risk of not returning
app.get('/api/ai/churn-prediction', async (req, res) => {
    try {
        // Get guests with their stay history
        const guests = await pool.query(`
            SELECT 
                g.id,
                g.full_name,
                g.email,
                g.total_stays,
                g.total_spent,
                MAX(r.check_out) as last_stay_date
            FROM guests g
            LEFT JOIN reservations r ON g.id = r.guest_id
            WHERE r.status = 'checked-out'
            GROUP BY g.id
            ORDER BY last_stay_date DESC
            LIMIT 20
        `);
        
        const atRiskGuests = [];
        
        for (const guest of guests.rows) {
            const lastStay = new Date(guest.last_stay_date);
            const daysSinceLastStay = Math.floor((new Date() - lastStay) / (1000 * 60 * 60 * 24));
            
            let riskScore = 0;
            let reasons = [];
            
            if (daysSinceLastStay > 90) {
                riskScore += 60;
                reasons.push(`No stay in ${daysSinceLastStay} days`);
            } else if (daysSinceLastStay > 60) {
                riskScore += 30;
                reasons.push(`Last stay over 2 months ago`);
            }
            
            if (guest.total_stays < 2) {
                riskScore += 20;
                reasons.push('New guest (only 1 stay)');
            }
            
            if (guest.total_spent < 200) {
                riskScore += 10;
                reasons.push('Low spending guest');
            }
            
            if (riskScore > 50) {
                atRiskGuests.push({
                    name: guest.full_name,
                    email: guest.email,
                    risk_score: riskScore,
                    risk_level: riskScore > 70 ? 'High' : 'Medium',
                    reasons: reasons,
                    last_stay: lastStay.toLocaleDateString(),
                    suggested_action: riskScore > 70 ? 'Send personalized offer immediately' : 'Send follow-up email with discount'
                });
            }
        }
        
        res.json({
            at_risk_guests: atRiskGuests.slice(0, 10),
            total_at_risk: atRiskGuests.length,
            retention_suggestions: [
                'Send personalized offers to at-risk guests',
                'Create loyalty program with exclusive benefits',
                'Follow up with guests after their stay',
                'Offer birthday discounts to encourage return visits'
            ]
        });
        
    } catch (err) {
        console.error('Churn prediction error:', err);
        res.json({ at_risk_guests: [], total_at_risk: 0, retention_suggestions: [] });
    }
});

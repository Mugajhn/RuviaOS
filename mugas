app.get('/api/ai/anomaly-detection', async (req, res) => {
    try {
        const anomalies = [];
        
        // Detect unusual stock changes (potential theft or error)
        const stockAnomalies = await pool.query(`
            SELECT 
                sm.*,
                p.name as product_name,
                p.current_stock
            FROM stock_movements sm
            JOIN products p ON sm.product_id = p.id
            WHERE sm.quantity_change < -10
            AND sm.created_at >= CURRENT_DATE - INTERVAL '7 days'
            ORDER BY sm.quantity_change ASC
            LIMIT 5
        `);
        
        for (const anomaly of stockAnomalies.rows) {
            anomalies.push({
                type: 'stock',
                severity: Math.abs(anomaly.quantity_change) > 20 ? 'high' : 'medium',
                message: `Unusual stock decrease: ${Math.abs(anomaly.quantity_change)} units of ${anomaly.product_name} removed`,
                details: `Reason: ${anomaly.reason || 'Not specified'}`,
                date: anomaly.created_at
            });
        }
        
        // Detect unusually high transaction values
        const transactionAnomalies = await pool.query(`
            SELECT 
                transaction_number,
                total_amount,
                created_at
            FROM pos_transactions
            WHERE total_amount > (
                SELECT AVG(total_amount) + 2 * STDDEV(total_amount) 
                FROM pos_transactions 
                WHERE created_at >= CURRENT_DATE - INTERVAL '30 days'
            )
            AND created_at >= CURRENT_DATE - INTERVAL '7 days'
            ORDER BY total_amount DESC
            LIMIT 5
        `);
        
        for (const anomaly of transactionAnomalies.rows) {
            anomalies.push({
                type: 'transaction',
                severity: anomaly.total_amount > 1000 ? 'high' : 'medium',
                message: `Unusually high transaction: $${anomaly.total_amount}`,
                details: `Transaction #: ${anomaly.transaction_number}`,
                date: anomaly.created_at
            });
        }
        
        // Detect low occupancy days
        const occupancyAnomalies = await pool.query(`
            SELECT 
                DATE(check_in) as date,
                COUNT(*) as arrivals
            FROM reservations
            WHERE check_in >= CURRENT_DATE - INTERVAL '14 days'
            GROUP BY DATE(check_in)
            HAVING COUNT(*) < (
                SELECT AVG(arrivals) - 2 * STDDEV(arrivals) 
                FROM (
                    SELECT DATE(check_in) as date, COUNT(*) as arrivals
                    FROM reservations
                    WHERE check_in >= CURRENT_DATE - INTERVAL '30 days'
                    GROUP BY DATE(check_in)
                ) as subq
            )
        `);
        
        for (const anomaly of occupancyAnomalies.rows) {
            anomalies.push({
                type: 'occupancy',
                severity: 'high',
                message: `Unusually low arrivals on ${new Date(anomaly.date).toLocaleDateString()}`,
                details: `Only ${anomaly.arrivals} arrivals compared to average`,
                date: anomaly.date
            });
        }
        
        res.json({
            anomalies: anomalies,
            total_anomalies: anomalies.length,
            alert: anomalies.filter(a => a.severity === 'high').length > 0 ? '⚠️ High severity anomalies detected. Review immediately.' : 'No critical anomalies detected.'

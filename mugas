// POST /api/check-in - Mark a guest as checked in
app.post('/api/check-in', async (req, res) => {
    const { reservation_number } = req.body;
    
    if (!reservation_number) {
        return res.status(400).json({ error: 'Reservation number required' });
    }
    
    try {
        // Get the room_id from the reservation
        const reservationResult = await pool.query(
            'SELECT room_id FROM reservations WHERE reservation_number = $1',
            [reservation_number]
        );
        
        if (reservationResult.rows.length === 0) {
            return res.status(404).json({ error: 'Reservation not found' });
        }
        
        const roomId = reservationResult.rows[0].room_id;
        
        // Update reservation status to 'checked-in'
        await pool.query(
            "UPDATE reservations SET status = 'checked-in' WHERE reservation_number = $1",
            [reservation_number]
        );
        
        // Update room status to 'occupied'
        await pool.query(
            "UPDATE rooms SET status = 'occupied', is_available = false WHERE id = $1",
            [roomId]
        );
        
        res.json({ success: true, message: 'Check-in successful' });
    } catch (err) {
        console.error(err);
        res.status(500).json({ error: 'Database error' });
    }
});


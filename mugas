// GET /api/housekeeping/rooms - Get all rooms with housekeeping info
app.get('/api/housekeeping/rooms', async (req, res) => {
    try {
        const result = await pool.query(`
            SELECT 
                r.id,
                r.room_number,
                r.room_type,
                r.status,
                r.floor_number,
                r.bed_count,
                r.max_occupancy,
                r.base_price,
                hk.assigned_housekeeper,
                hk.last_cleaned,
                hk.notes as housekeeping_notes
            FROM rooms r
            LEFT JOIN housekeeping_log hk ON r.id = hk.room_id 
                AND hk.created_at = (SELECT MAX(created_at) FROM housekeeping_log WHERE room_id = r.id)
            GROUP BY r.id, hk.assigned_housekeeper, hk.last_cleaned, hk.notes
            ORDER BY r.room_number

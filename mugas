                COUNT(*) as arrivals
            FROM reservations
            WHERE check_in BETWEEN CURRENT_DATE AND CURRENT_DATE + INTERVAL '7 days'
            AND status = 'confirmed'
            GROUP BY check_in
        `);
        
        const schedule = [];
        for (let i = 0; i < 7; i++) {
            const date = new Date();
            date.setDate(date.getDate() + i);
            const dateStr = date.toISOString().split('T')[0];
            
            const departures = checkouts.rows.find(c => c.check_out.toISOString().split('T')[0] === dateStr)?.departures || 0;
            const arrivals = checkins.rows.find(c => c.check_in.toISOString().split('T')[0] === dateStr)?.arrivals || 0;
            
            const totalWorkload = departures + arrivals;
            let recommendedStaff = 2;
            let shiftNeeded = 'normal';
            
            if (totalWorkload > 20) {
                recommendedStaff = 6;
                shiftNeeded = 'full team';
            } else if (totalWorkload > 10) {
                recommendedStaff = 4;
                shiftNeeded = 'extended';
            } else if (totalWorkload > 5) {
                recommendedStaff = 3;
                shiftNeeded = 'normal';
            } else {
                recommendedStaff = 2;
                shiftNeeded = 'reduced';
            }
            
            schedule.push({
                date: dateStr,
                weekday: date.toLocaleDateString('en-US', { weekday: 'long' }),
                expected_checkouts: departures,
                expected_checkins: arrivals,
                total_workload: totalWorkload,
                recommended_staff: recommendedStaff,
                shift_needed: shiftNeeded
            });
